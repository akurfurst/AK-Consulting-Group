<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="landing">

    <section class="hero">
        <div class="hero__grid">
            <div class="hero__copy">
                <p class="eyebrow">B2B Office Supply</p>
                <h1 class="hero__headline">
                    The supplies your office <em>actually</em> runs on.
                </h1>
                <p class="hero__lede">
                    AK Office Supplies stocks the paper, pens, and desk essentials
                    that keep modern workplaces moving — priced for businesses, schools,
                    and industrial buyers.
                </p>
                <div class="hero__cta">
                    <a href="/products" class="btn btn--primary">Shop the catalog</a>
                    <a href="/register" class="btn btn--text">Open a business account →</a>
                </div>

                <ul class="hero__proof">
                    <li><strong>20+</strong><span>SKUs in catalog</span></li>
                    <li><strong>2-day</strong><span>standard shipping</span></li>
                    <li><strong>Net 30</strong><span>terms for verified buyers</span></li>
                </ul>
            </div>

            <aside class="hero__panel" aria-hidden="true">
                <div class="hero__panel-inner">
                    <div class="hero__stack">
                        <div class="stack-card stack-card--1">
                            <span class="dot"></span>
                            <p class="stack-card__label">Order #AK-10428</p>
                            <p class="stack-card__title">Printer Paper · 500 Sheets</p>
                            <p class="stack-card__meta">Ships today · Tracked</p>
                        </div>
                        <div class="stack-card stack-card--2">
                            <span class="dot dot--ok"></span>
                            <p class="stack-card__label">Restock</p>
                            <p class="stack-card__title">Ballpoint Pens · Pack of 10</p>
                            <p class="stack-card__meta">In stock</p>
                        </div>
                        <div class="stack-card stack-card--3">
                            <span class="dot dot--ok"></span>
                            <p class="stack-card__label">Reorder</p>
                            <p class="stack-card__title">Sticky Notes · Pack of 12</p>
                            <p class="stack-card__meta">Bulk pricing applied</p>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    <!-- ============ VALUE STRIP ============ -->
    <section class="value-strip" aria-label="Why choose AK Office Supplies">
        <ul>
            <li>
                <h3>Built for procurement</h3>
                <p>Approval workflows, recurring orders, and clear invoicing — designed for the way your team actually buys.</p>
            </li>
            <li>
                <h3>Quality you can trust</h3>
                <p>Every SKU in our catalog is hand-picked for reliable everyday use. No mystery overstock, no off-brand fillers.</p>
            </li>
            <li>
                <h3>Bulk pricing, no haggling</h3>
                <p>Volume discounts apply automatically at checkout. Open a business account for additional contract pricing.</p>
            </li>
        </ul>
    </section>

    <!-- ============ FEATURED PRODUCTS ============ -->
    <section class="featured" aria-labelledby="featured-heading">
        <p class="eyebrow eyebrow--center">This week's picks</p>
        <h2 id="featured-heading" class="section-heading">Featured products</h2>

        <ul class="featured__grid">
            <% featured.forEach(product => { %>
                <li class="featured__card">
                    <div class="featured__media">
                        <img src="/images/products/<%= product.image %>" alt="<%= product.name %>">
                    </div>
                    <div class="featured__body">
                        <p class="featured__category"><%= product.category %></p>
                        <h3 class="featured__title"><%= product.name %></h3>
                        <p class="featured__desc"><%= product.description %></p>
                        <div class="featured__foot">
                            <p class="featured__price">
                                <span class="currency">$</span><%= product.price %>
                            </p>
                            <a href="/products" class="btn btn--text">View →</a>
                        </div>
                    </div>
                </li>
            <% }) %>
        </ul>
    </section>

    <!-- ============ CATEGORIES ============ -->
    <section class="categories" aria-labelledby="categories-heading">
        <div class="categories__head">
            <h2 id="categories-heading" class="section-heading">Browse by category</h2>
            <a href="/products" class="btn btn--text">See everything →</a>
        </div>

        // The category grid is intentionally simple — just links with text, no images — to keep the focus on the products themselves. 
        // Each card includes a brief description to help buyers quickly find what they need without having to click through multiple pages.
        <ul class="categories__grid">
            <li><a href="/products"><span>01</span><h4>Writing Supplies</h4><p>Pens, pencils, highlighters, markers</p></a></li>
            <li><a href="/products"><span>02</span><h4>Paper Products</h4><p>Printer paper, sticky notes, legal pads</p></a></li>
            <li><a href="/products"><span>03</span><h4>Desk Accessories</h4><p>Staplers, scissors, tape, organizers</p></a></li>
            <li><a href="/products"><span>04</span><h4>Organization</h4><p>Folders, binders, hanging files</p></a></li>
        </ul>
    </section>

</main>

<%- include('partials/footer') %>
