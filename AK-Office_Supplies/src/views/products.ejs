<%- include('partials/header') %>

<h1>All Products</h1>

<div id="allCards">
    <% products.forEach(product => { %>
        <a class="productCard" href="/products/<%= product.product_id %>">
            <div class="img-wrapper">
                <img src="/images/products/<%= product.image_file %>" alt="<%= product.product_name %>" />
            </div>
            <h2><%= product.product_name %></h2>
        </a>
    <% }) %>
</div>

<%- include('partials/footer') %>