<%- include('partials/header') %>

<section id="all_products">
    <h1>All Products</h1>

    <div id="allCards">
        <% products.forEach(product => { %>
            <div class="productCard"
                 data-id="<%= product.product_id %>"
                 data-name="<%= product.product_name %>"
                 data-price="<%= product.price %>"
                 data-category="<%= product.category %>"
                 data-image="<%= product.image_file %>"
                 data-description="<%= product.product_description %>">
                <img src="/images/<%= product.image_file %>"
                     alt="<%= product.product_name %>"
                     onerror="this.src='/images/default.webp'" />
                <h3><%= product.product_name %></h3>
                <p class="price">$<%= product.price %></p>
            </div>
        <% }) %>
    </div>
</section>

<!-- PRODUCT MODAL — rendered once, hidden until a card is clicked -->
<div id="productModal" class="modal-overlay" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <button class="modal-close" id="modalClose" aria-label="Close">&times;</button>
        <img id="modalImage" class="modal-image" src="" alt="" />
        <div class="modal-body">
            <h2 id="modalTitle"></h2>
            <p id="modalCategory" class="modal-category"></p>
            <p id="modalPrice" class="price"></p>
            <p id="modalDescription"></p>
            <a id="modalLink" class="button" href="#">View full page</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>