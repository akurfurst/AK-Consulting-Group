<%- include('partials/header') %>

<header class="hero">
    <div class="hero-content">
        <h1>Your Office, Fully Stocked</h1>
        <p>
            AK Office Supplies delivers professional-grade office essentials
            to businesses of all sizes. From writing tools to filing systems,
            we have everything your workspace needs.
        </p>
        <a class="button" href="/products">Shop All Products</a>
    </div>
    <div class="hero-image">
        <img src="/images/ak_consulting_group_logo.png" alt="Office supplies on a clean desk" />
    </div>
</header>

<main class="container">

    <section class="featured">
        <h2>Featured Product</h2>
        <div class="product-card">
            <img src="/images/default.webp" alt="Ballpoint Pens - Pack of 10" />
            <div class="product-info">
                <h3>Ballpoint Pens — Pack of 10</h3>
                <p>
                    Smooth, reliable black ink pens built for daily office use.
                    Comfortable grip, consistent flow, and long-lasting ink make
                    these a workspace staple.
                </p>
                <span class="price">$5.00</span>
                <a class="button secondary" href="/products">View All Products</a>
            </div>
        </div>
    </section>

    <section class="categories">
        <h2>Shop by Category</h2>
        <div class="category-grid">
            <div class="category-card">
                <h3>Writing Supplies</h3>
                <p>Pens, pencils, markers, and more.</p>
                <a href="/products">Browse →</a>
            </div>
            <div class="category-card">
                <h3>Paper Products</h3>
                <p>Printer paper, notepads, and labels.</p>
                <a href="/products">Browse →</a>
            </div>
            <div class="category-card">
                <h3>Desk Accessories</h3>
                <p>Staplers, organizers, clips, and tape.</p>
                <a href="/products">Browse →</a>
            </div>
            <div class="category-card">
                <h3>Organization</h3>
                <p>Binders, folders, and filing systems.</p>
                <a href="/products">Browse →</a>
            </div>
        </div>
    </section>

</main>

<%- include('partials/footer') %>